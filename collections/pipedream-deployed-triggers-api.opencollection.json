              }
            ],
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "The project ID, which starts with `proj_`."
              },
              {
                "name": "trigger_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "webhook_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "external_user_id",
                "value": "",
                "type": "query",
                "description": "The external user ID who owns the trigger"
              }
