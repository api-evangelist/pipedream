          "http": {
            "method": "PUT",
            "url": "https://remote.mcp.pipedream.net/v3/v1/connect/:project_id/deployed-triggers/:trigger_id/webhooks",
            "headers": [
              {
                "name": "x-pd-environment",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "The project ID, which starts with `proj_`."
              },
              {
                "name": "trigger_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "external_user_id",
                "value": "",
                "type": "query",
                "description": "The external user ID who owns the trigger"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Configure webhook URLs to receive trigger events. `signing_key` is only returned for OAuth-authenticated requests."
        },
        {
          "info": {
            "name": "Get Trigger Webhook",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://remote.mcp.pipedream.net/v3/v1/connect/:project_id/deployed-triggers/:trigger_id/webhooks/:webhook_id",
            "headers": [
              {
                "name": "x-pd-environment",
                "value": ""
              }
            ],
            "params": [
