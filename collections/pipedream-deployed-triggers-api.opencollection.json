            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "The project ID, which starts with `proj_`."
              },
              {
                "name": "trigger_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "external_user_id",
                "value": "",
                "type": "query",
                "description": "The external user ID who owns the trigger"
              }
            ]
          },
          "docs": "Get workflows connected to receive events from this trigger"
        },
        {
          "info": {
            "name": "Update Trigger Workflows",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://remote.mcp.pipedream.net/v3/v1/connect/:project_id/deployed-triggers/:trigger_id/pipelines",
            "headers": [
              {
                "name": "x-pd-environment",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "The project ID, which starts with `proj_`."
              },
              {
                "name": "trigger_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "external_user_id",
                "value": "",
                "type": "query",
                "description": "The external user ID who owns the trigger"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Connect or disconnect workflows to receive trigger events"
        },
        {
          "info": {
            "name": "List Trigger Webhooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://remote.mcp.pipedream.net/v3/v1/connect/:project_id/deployed-triggers/:trigger_id/webhooks",
            "headers": [
              {
                "name": "x-pd-environment",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "The project ID, which starts with `proj_`."
              },
              {
                "name": "trigger_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "external_user_id",
                "value": "",
                "type": "query",
                "description": "The external user ID who owns the trigger"
              }
            ]
          },
          "docs": "Get webhook URLs configured to receive trigger events"
