{
  "opencollection": "1.0.0",
  "info": {
    "name": "Pipedream MCP Server Accounts Projects API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Projects",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Projects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://remote.mcp.pipedream.net/v3/v1/connect/projects",
            "params": [
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "The cursor to start from for pagination"
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "The cursor to end before for pagination"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of results to return"
              },
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "A search query to filter the projects"
              }
            ]
          },
          "docs": "List the projects that are available to the authenticated Connect client"
        },
        {
          "info": {
            "name": "Create Project",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://remote.mcp.pipedream.net/v3/v1/connect/projects",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new project for the authenticated workspace"
        },
        {
          "info": {
            "name": "Retrieve Project",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://remote.mcp.pipedream.net/v3/v1/connect/projects/:project_id",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "The project ID, which starts with `proj_`."
              }
            ]
          },
          "docs": "Get the project details for a specific project"
        },
        {
          "info": {
            "name": "Update Project",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://remote.mcp.pipedream.net/v3/v1/connect/projects/:project_id",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "The project ID, which starts with `proj_`."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update project details or application information"
        },
        {
          "info": {
            "name": "Delete Project",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://remote.mcp.pipedream.net/v3/v1/connect/projects/:project_id",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "The project ID, which starts with `proj_`."
              }
            ]
          },
          "docs": "Delete a project owned by the authenticated workspace"
        },
        {
          "info": {
            "name": "Update Project Logo",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://remote.mcp.pipedream.net/v3/v1/connect/projects/:project_id/logo",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "The project ID, which starts with `proj_`."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Upload or replace the project logo"
        },
        {
          "info": {
            "name": "Get Project Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://remote.mcp.pipedream.net/v3/v1/connect/:project_id/projects/info",
            "headers": [
              {
                "name": "x-pd-environment",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "The project ID, which starts with `proj_`."
              }
            ]
          },
          "docs": "Retrieve project configuration and environment details"
        }
      ]
    }
  ],
  "bundled": true
}