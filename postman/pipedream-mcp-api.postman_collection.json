  "info": {
    "_postman_id": "8f51ae48-efed-4688-be8a-13943b51fb4d",
    "name": "Pipedream Server Accounts MCP API",
    "description": "Pipedream's Model Context Protocol (MCP) server exposes 2,800+ integrated apps and 10,000+ tools as a hosted MCP endpoint. The server supports both SSE and streamable HTTP transports dynamically with no client configuration required. Authentication uses OAuth 2.0 client credentials; per-request context is supplied via x-pd-project-id, x-pd-environment, x-pd-external-user-id, and x-pd-app-slug headers. Source: https://pipedream.com/docs/connect/mcp/developers\n\nContact Support:\n Name: Pipedream",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T02:37:02.000Z",
    "updatedAt": "2026-07-28T02:37:02.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-8f51ae48-efed-4688-be8a-13943b51fb4d"
  },
